{
  "manifest_version": 3,
  "name": "SlideHuddle",
  "version": "0.4.0",
  "description": "Detects HTML slides in Claude conversations and opens them in SlideHuddle, and fills the team's feedback back into Claude's message box.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SlideHuddle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://*.claudemcpcontent.com/*",
        "https://*.claudeusercontent.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://slidehuddleapp.vercel.app/*",
    "https://*.claude.ai/*",
    "https://*.claudemcpcontent.com/*",
    "https://*.claudeusercontent.com/*"
  ]
}
